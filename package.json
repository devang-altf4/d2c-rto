{
  "name": "rto",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "db:push": "pnpm --filter @rto/db exec prisma db push",
    "db:studio": "pnpm --filter @rto/db exec prisma studio",
    "db:seed": "pnpm --filter @rto/db run seed",
    "data:generate": "tsx scripts/generate.ts"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
