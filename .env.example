# Shared by all three workstreams. Copy to .env — never commit the real one.

# Neon Postgres (one URL, all three devs point at it)
DATABASE_URL="postgresql://user:pass@ep-xxx.aws.neon.tech/rto?sslmode=require"

# L2 — Rohit (Twilio WhatsApp)
TWILIO_ACCOUNT_SID=""
# Scoped API key — preferred. The account auth token below is the fallback.
TWILIO_API_KEY_SID=""
TWILIO_API_KEY_SECRET=""
TWILIO_AUTH_TOKEN=""
# Sender, with the channel prefix, e.g. whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=""
# Unset = send our own per-order copy (needs the 24h window open).
# Set = send this approved Content template instead (needed to open a chat cold).
# TWILIO_WHATSAPP_CONTENT_SID=""
# Optional: public URL Twilio posts delivery receipts to.
TWILIO_STATUS_CALLBACK_URL=""

# L3 — Devang (Sarvam AI Instant Outbound)
SARVAM_API_KEY=""
SARVAM_ORG_ID=""
SARVAM_WORKSPACE_ID=""
SARVAM_APP_ID=""
SARVAM_CONNECTION_ID=""
SARVAM_PHONE_NUMBER=""
SARVAM_APP_VERSION="1"

# Demo
DEMO_PHONE="+9198XXXXXXXX"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Try-on preview (optional). ROTATE THIS IF IT WAS EVER PASTED IN CHAT.
OPENAI_API_KEY=""
OPENAI_IMAGE_MODEL="gpt-image-2"
